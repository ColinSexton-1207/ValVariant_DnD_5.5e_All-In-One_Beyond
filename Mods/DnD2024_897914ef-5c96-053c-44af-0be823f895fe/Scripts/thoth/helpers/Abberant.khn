function AbberantPsionicSpells()
    return SpellId('Shout_ArmsOfHadar')
    | SpellId('Target_BlackTentacles')
    | SpellId('Target_CalmEmotions')
    | SpellId('Target_DissonantWhispers')
    | SpellId('Target_HungerOfHadar')
    | SpellId('Target_SummonAberration')
    | SpellId('Target_SummonAberration_5')
    | SpellId('Target_SummonAberration_6')
    | SpellId('Target_SummonAberration_IntellectDevourer')
    | SpellId('Target_SummonAberration_IntellectDevourer_5')
    | SpellId('Target_SummonAberration_IntellectDevourer_6')
    | SpellId('Target_SummonAberration_Beholder')
    | SpellId('Target_SummonAberration_Beholder_5')
    | SpellId('Target_SummonAberration_Beholder_6')
    | SpellId('Target_SummonAberration_MindFlayer')
    | SpellId('Target_SummonAberration_MindFlayer_5')
    | SpellId('Target_SummonAberration_MindFlayer_6')
    | SpellId('Throw_Telekinesis')
end