function RecklessAttack()
    return SpellId('Target_RecklessAttack')
    | SpellId('Target_RecklessAttackAction')
    | SpellId('Target_RecklessAttackForcefulBlow')
    | SpellId('Target_RecklessAttackHamstringBlow')
    | SpellId('Target_RecklessAttack_Unarmed')
    | SpellId('Target_RecklessAttackAction_Unarmed')
    | SpellId('Target_RecklessAttackForcefulBlow_Unarmed')
    | SpellId('Target_RecklessAttackHamstringBlow_Unarmed')
    | SpellId('Throw_Throw_RecklessAttack')
end